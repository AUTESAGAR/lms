<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Change Password</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <%- include('./components/header') %>

    <main class="container auth-layout">
        <section class="auth-panel">
            <span class="eyebrow">Verify OTP</span>
            <h1 class="hero-title fs-1">Create a new password.</h1>
            <p class="hero-copy">Use the OTP from your email and choose a fresh password for your account.</p>
        </section>

        <section class="form-card">
            <h3 class="fw-bold mb-4">Change Password</h3>
            <form action="/change-password" method="post">
                <label class="form-label fw-bold">OTP</label>
                <input type="text" name="otp" class="form-control mb-3" placeholder="Enter OTP">

                <label class="form-label fw-bold">New Password</label>
                <input type="password" name="password" class="form-control mb-3" placeholder="Enter new password">

                <label class="form-label fw-bold">Confirm Password</label>
                <input type="password" name="confirmPassword" class="form-control mb-3" placeholder="Confirm new password">

                <% if(message){ %>
                    <div class="alert-soft mb-3"><%= message %></div>
                <% } %>

                <button class="btn btn-brand w-100">Update Password</button>
            </form>
        </section>
    </main>


    <%- include('./components/footer') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
