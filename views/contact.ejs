<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Contact Us</title>

  <link rel="stylesheet" href="/css/chatbot.css">
</head>
<body>

<section class="contact-section">

    <div class="left-box">

        <span class="tag">
            AI Powered Support
        </span>

        <h1>
            Contact VIT Technology Solution
        </h1>

        <p>
            Ask anything about courses, fees, online lectures,
            placement, career guidance and admissions.
        </p>

        <div class="info-box">

            <h3>Institute Address</h3>

            <p>
                Rajmata complex, 3rd floor,
                above mannubhai mithaiwale shop,
                kranti chowk, chh.sambhajinagar - 431001
            </p>

        </div>

    </div>

    <div class="chat-container">

        <div class="chat-header">
            VIT AI Assistant
        </div>

        <div class="chat-body" id="chatBody">

            <div class="bot-message">
                Hello 👋 <br>
                Ask me anything about courses, fees or placements.
            </div>

        </div>

        <div class="chat-footer">

            <input
                type="text"
                id="message"
                placeholder="Ask your question..."
            >

            <button onclick="sendMessage()">
                Send
            </button>

        </div>

    </div>

</section>

<script src="/js/chatbot.js"></script>

</body>
</html>