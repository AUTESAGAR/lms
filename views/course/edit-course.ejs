<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Course</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <%- include('../components/header') %>

    <main class="container auth-layout">
        <section class="auth-panel">
            <span class="eyebrow">Course editor</span>
            <h1 class="hero-title fs-1">Refresh course details.</h1>
            <p class="hero-copy">Keep title, pricing and thumbnail aligned with the course catalog experience.</p>
            <img src="http://localhost:1000/<%- courseData.thumbnail %>" alt="thumbnail" class="w-100 mt-3" style="border-radius:8px;aspect-ratio:16/9;object-fit:cover;">
        </section>

        <section class="form-card">
            <h3 class="fw-bold mb-1">Edit Course</h3>
            <p class="muted-copy mb-4">Update course information.</p>
            <form action="/edit-course/<%- courseData._id %>" method="post" enctype="multipart/form-data">
                <label class="form-label fw-bold">Course Title</label>
                <input type="text" value="<%- courseData.title %>" name="title" class="form-control mb-3" placeholder="Enter course title">

                <label class="form-label fw-bold">Description</label>
                <textarea name="description" class="form-control mb-3" rows="4" placeholder="Enter course description"><%- courseData.description %></textarea>

                <label class="form-label fw-bold">Fees</label>
                <input type="number" value="<%- courseData.fees %>" name="fees" class="form-control mb-3" placeholder="Enter course fees">

                <label class="form-label fw-bold">Replace Thumbnail</label>
                <input type="file" name="thumbnail" class="form-control mb-4" accept=".jpg,.jpeg,.png,.webp,.avif">

                <button class="btn btn-brand w-100">Update Course</button>
            </form>
        </section>
    </main>

    <%- include('../components/footer') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
