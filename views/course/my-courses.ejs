<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Learning</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
   <%- include('../components/header') %>

    <main class="section-wrap">
        <div class="container">
            <div class="section-head">
                <div>
                    <h1 class="page-title">My Learning</h1>
                    <p>Continue your enrolled courses from one focused dashboard.</p>
                </div>
                <a href="/home" class="btn btn-warning">Explore More</a>
            </div>

            <% if (courseData && courseData.length) { %>
                <div class="course-grid">
                    <% courseData.forEach(courseData => { %>
                        <article class="course-card">
                            <img class="course-thumb" src="http://localhost:1000/<%- courseData.thumbnail %>" alt="<%- courseData.title %> thumbnail">
                            <div class="course-body">
                                <span class="course-tag">Enrolled</span>
                                <h3 class="course-title"><%- courseData.title %></h3>
                                <p class="course-desc"><%- courseData.description.slice(0,150) %></p>
                                <div class="course-meta">
                                    <span class="rating">Ready to learn</span>
                                </div>
                                <a href="/learn-course/<%- courseData._id %>" class="btn btn-brand w-100">Continue Course</a>
                            </div>
                        </article>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="empty-state">
                    Course Not Available
                    <div class="mt-3"><a href="/home" class="btn btn-brand">Browse Courses</a></div>
                </div>
            <% } %>
        </div>
    </main>

    <%- include('../components/footer') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
