<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>

<%- include('./components/header') %>

<main class="section-wrap">
    <div class="container">
        <% if (ordersData) { %>
            <%
                let totalIncome = 0;
                ordersData.forEach(order => {
                    totalIncome += order.courseFees;
                });

                let enrolledStudents = ordersData.length;
                let registeredStudents = regUsersData.length;
                let totalEnquiries = enqueriesData.length;
            %>

            <div class="section-head">
                <div>
                    <h1 class="page-title">Admin Dashboard</h1>
                    <p>Track revenue, enrollments and learner activity across the LMS.</p>
                </div>
                <a href="/add-course" class="btn btn-brand">Create Course</a>
            </div>

            <div class="row g-3">
                <div class="col-md-3">
                    <div class="dashboard-stat">
                        <span>Total Income</span>
                        <strong>&#8377; <span id="total-income"><%= totalIncome %></span></strong>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="dashboard-stat">
                        <span>Enrolled Students</span>
                        <strong id="enrolled-students"><%= enrolledStudents %></strong>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="dashboard-stat">
                        <span>Registered Students</span>
                        <strong id="registered-students"><%= registeredStudents %></strong>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="dashboard-stat">
                        <span>Payment Enquiries</span>
                        <strong id="total-enquiries"><%= totalEnquiries %></strong>
                    </div>
                </div>
            </div>

            <div class="row g-4 mt-4">
                <div class="col-lg-7">
                    <div class="dashboard-panel p-4">
                        <h4 class="fw-bold mb-4">Statistics Overview</h4>
                        <canvas id="barChart"></canvas>
                    </div>
                </div>
                <div class="col-lg-5">
                    <div class="dashboard-panel p-4">
                        <h4 class="fw-bold mb-4">Student Analytics</h4>
                        <canvas id="pieChart"></canvas>
                    </div>
                </div>
            </div>
        <% } %>
    </div>
</main>

<%- include('./components/footer') %>

<script>
    const totalIncome = Number(document.getElementById('total-income').textContent || 0);
    const enrolledStudents = Number(document.getElementById('enrolled-students').textContent || 0);
    const registeredStudents = Number(document.getElementById('registered-students').textContent || 0);
    const totalEnquiries = Number(document.getElementById('total-enquiries').textContent || 0);

    new Chart(document.getElementById('barChart'), {
        type: 'bar',
        data: {
            labels: ['Enrolled', 'Registered', 'Enquiries'],
            datasets: [{
                label: 'Dashboard Statistics',
                data: [enrolledStudents, registeredStudents, totalEnquiries],
                backgroundColor: ['#f97316', '#fb923c', '#10b981'],
                borderRadius: 8,
                borderWidth: 0
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { display: false } }
        }
    });

    new Chart(document.getElementById('pieChart'), {
        type: 'doughnut',
        data: {
            labels: ['Income', 'Enrolled', 'Registered', 'Enquiries'],
            datasets: [{
                data: [totalIncome, enrolledStudents, registeredStudents, totalEnquiries],
                backgroundColor: ['#c2410c', '#f97316', '#fb923c', '#10b981'],
                borderWidth: 0
            }]
        },
        options: {
            responsive: true,
            cutout: '68%'
        }
    });
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
