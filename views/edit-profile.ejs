<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Profile</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <%- include('./components/header') %>

    <main class="container auth-layout">
        <section class="auth-panel">
            <span class="eyebrow">Account settings</span>
            <h1 class="hero-title fs-1">Keep your profile updated.</h1>
            <p class="hero-copy">Your profile appears in the LMS header and helps separate student/admin experiences.</p>
            <img src="<%- userData.photo %>" alt="Profile Photo" class="mt-3" style="width:130px;height:130px;border-radius:50%;object-fit:cover;border:5px solid #fed7aa;">
        </section>

        <section class="form-card">
            <h3 class="fw-bold mb-1">Edit Profile</h3>
            <p class="muted-copy mb-4">Update your personal details.</p>
            <form action="/edit-profile" method="post" enctype="multipart/form-data">
                <label class="form-label fw-bold">Name</label>
                <input type="text" value="<%- userData.name %>" name="name" id="name" class="form-control mb-3" placeholder="Enter your name">

                <label class="form-label fw-bold">Mobile</label>
                <input type="text" value="<%- userData.mobile %>" name="mobile" id="mobile" class="form-control mb-3" placeholder="Enter mobile">

                <label class="form-label fw-bold">Email</label>
                <input type="text" value="<%- userData.email %>" name="email" id="email" class="form-control mb-3" placeholder="Enter email">

                <label class="form-label fw-bold">Profile Photo</label>
                <input type="file" name="photo" id="photo" class="form-control mb-3" accept=".jpg,.jpeg,.png,.webp,.avif">

                <% if (typeof message !== "undefined" && message) { %>
                    <div class="alert-soft mb-3"><%= message %></div>
                <% } %>

                <button class="btn btn-brand w-100">Update Profile</button>
            </form>
        </section>
    </main>

    <%- include('./components/footer') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
