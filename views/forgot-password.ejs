<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <%- include('./components/header') %>

    <main class="container auth-layout">
        <section class="auth-panel">
            <span class="eyebrow">Account recovery</span>
            <h1 class="hero-title fs-1">Reset your password securely.</h1>
            <p class="hero-copy">Enter your registered email and we will send an OTP to continue password reset.</p>
        </section>

        <section class="form-card">
            <h3 class="fw-bold mb-1">Forgot Password</h3>
            <p class="muted-copy mb-4">OTP will be sent to your email.</p>
            <form action="/forgot-password" method="post">
                <label class="form-label fw-bold">Email</label>
                <input type="email" name="email" class="form-control mb-4" placeholder="name@example.com">
                <div class="d-flex justify-content-between align-items-center gap-3">
                    <a href="/reg" class="fw-bold text-decoration-none text-muted">Create Account</a>
                    <button class="btn btn-brand">Send OTP</button>
                </div>
            </form>
        </section>
    </main>

    <%- include('./components/footer') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
