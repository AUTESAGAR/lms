<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Explore Courses</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
   <%- include('./components/header') %>

    <main class="app-shell">
        <section class="hero-section">
            <div class="container hero-inner">
                <div>
                    <span class="eyebrow">Welcome back, <%- userData.name %></span>
                    <h1 class="hero-title">Choose your next skill and keep learning.</h1>
                    <p class="hero-copy">Browse practical courses, view the syllabus and enroll into the program that matches your career goal.</p>
                    <div class="hero-actions">
                        <a href="#courses" class="btn btn-brand">Browse Courses</a>
                        <a href="/my-courses" class="btn btn-warning">My Learning</a>
                    </div>
                </div>
                <div class="hero-card">
                    <div class="stat-strip m-0">
                        <div class="stat-pill"><strong>Video</strong><span>Lessons</span></div>
                        <div class="stat-pill"><strong>PDF</strong><span>Resources</span></div>
                        <div class="stat-pill"><strong>Project</strong><span>Practice</span></div>
                    </div>
                </div>
            </div>
        </section>

        <section class="section-wrap" id="courses">
            <div class="container">
                <div class="section-head">
                    <div>
                        <h2>Available Courses</h2>
                        <p>Professional tracks built for practical upskilling.</p>
                    </div>
                </div>

                <% if (courseData && courseData.length) { %>
                    <div class="course-grid">
                        <% courseData.forEach(courseData => { %>
                            <article class="course-card">
                                <img class="course-thumb" src="http://localhost:1000/<%- courseData.thumbnail %>" alt="<%- courseData.title %> thumbnail">
                                <div class="course-body">
                                    <span class="course-tag">Lifetime access</span>
                                    <h3 class="course-title"><%- courseData.title %></h3>
                                    <p class="course-desc"><%- courseData.description.slice(0,150) %></p>
                                    <div class="course-meta">
                                        <span class="price">&#8377; <%- courseData.fees %></span>
                                        <span class="rating">4.8 rating</span>
                                    </div>
                                    <div class="action-row">
                                        <form action="/buy-now" method="POST" class="flex-grow-1">
                                            <input type="text" name="courseId" value="<%- courseData._id %>" hidden>
                                            <button class="btn btn-brand w-100">Buy Now</button>
                                        </form>
                                        <a href="/view-course/<%- courseData._id %>" class="btn btn-warning flex-grow-1">View Details</a>
                                    </div>
                                </div>
                            </article>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div class="empty-state">Course Not Available</div>
                <% } %>
            </div>
        </section>
    </main>

    <%- include('./components/footer') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
